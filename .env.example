# Copy this file to .env and fill in real values. .env is never committed.
# On Vercel, add the same keys in Project Settings > Environment Variables.

# Database (added automatically when Neon is connected to the project)
DATABASE_URL=

# Real "Gilad" account. First sign-in copies the jobs from JOBIMP_GILAD_DATA into the database.
JOBIMP_GILAD_PASSWORD=
JOBIMP_GILAD_DATA=

# App secret: signs sessions, encrypts Google tokens, protects the push and cron endpoints.
CRON_SECRET=

# Google sign-in (read-only Gmail + Calendar) and instant Gmail updates (Pub/Sub topic)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PUBSUB_TOPIC=projects/YOUR-PROJECT/topics/jobimp-gmail

# Reads job emails with Claude. Required: without it Gmail is not read.
ANTHROPIC_API_KEY=
